{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marlin",
  "version": "0.1.0",
  "identifier": "dev.gazar.marlin",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "marlin",
        "width": 1040,
        "height": 700,
        "minWidth": 520,
        "minHeight": 360,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0A0F16"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A terminal built for running coding agents",
    "copyright": "MIT"
  }
}
