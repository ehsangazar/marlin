{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marlin",
  "mainBinaryName": "marlin",
  "version": "../package.json",
  "identifier": "dev.gazar.marlin",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "marlin",
        "width": 1040,
        "height": 700,
        "minWidth": 520,
        "minHeight": 360,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0A0F16"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "The terminal where you read what your agents did",
    "copyright": "MIT",
    "resources": {
      "../shell/marlin.zsh": "shell/marlin.zsh",
      "../shell/marlin.fish": "shell/marlin.fish"
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
